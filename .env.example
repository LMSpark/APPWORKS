# 开发态必须显式指定 lowcode-jdk17 gateway；浏览器仍只请求同源 /api。
LOWCODE_GATEWAY_URL=http://127.0.0.1:8080

# 可选：将前端审计日志发送到明确配置的平台端点。
VITE_AUDIT_REMOTE_LOGS=false
# VITE_AUDIT_LOG_ENDPOINT=/api/your-governed-audit-endpoint

# JSON map from exact tenant shortName to an existing formal AI data-entry Agent ID; no fallback is used.
VITE_AI_DATA_ENTRY_AGENTS={}
