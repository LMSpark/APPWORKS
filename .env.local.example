# 复制为 .env.local 后填写本机 lowcode-jdk17 gateway 地址。
# 不要在本文件或仓库中保存账号、口令、Token、数据库连接串或模型密钥。
LOWCODE_GATEWAY_URL=http://127.0.0.1:8080

# 工作流 G0/D99（tools/workflow/read-workflow-model-ids.mjs、run-g0-apply.mjs）
# 未写 SPARK_BASE_URL 时，load-spark-env 会用上方 LOWCODE_GATEWAY_URL 作为 API 根址。
# SPARK_BASE_URL=http://127.0.0.1:5273
# SPARK_TOKEN=   # 浏览器已登录 D99 后，从任意 /api 请求的 Authorization: Bearer … 复制
# 或烟测自动登录（勿提交仓库）：
# SPARK_LOGIN_ENT=领码科技
# SPARK_LOGIN_USER=
# SPARK_LOGIN_PASSWORD=
# SPARK_APP_ID=D99A1DCE9894698799101EFD70F8FC76
# WORKFLOW_SMOKE_WFID=

# 仅当平台已提供受治理的审计端点时启用。
VITE_AUDIT_REMOTE_LOGS=false
# VITE_AUDIT_LOG_ENDPOINT=/api/your-governed-audit-endpoint
