          },
          "type": "custom",
          "data": {
            "relation": "sequence",
            "branch": {
              "label": "sequence",
              "default": true
            },
            "validation": {}
          }
        },
        {
          "id": "line.4",
          "from": {
            "nodeId": "node.ruleBehaviorAssets",
            "modelId": "node.ruleBehaviorAssets.page",
            "memberName": "toDefinition"
          },
          "to": {
            "nodeId": "node.renderCloseout",
            "modelId": "node.renderCloseout.page",
            "memberName": "toDefinition"
          },
          "type": "custom",
          "data": {
            "relation": "sequence",
            "branch": {
              "label": "sequence",
              "default": true
            },
            "validation": {}
          }
        },
        {
          "id": "line.5",
          "from": {
            "nodeId": "node.renderCloseout",
            "modelId": "node.renderCloseout.page",
            "memberName": "toDefinition"
          },
          "to": {
            "nodeId": "output",
            "modelId": "$workflow",
            "memberName": "result"
          },
          "type": "custom",
          "data": {
            "relation": "sequence",
            "branch": {
              "label": "sequence",
              "default": true
            },
            "validation": {}
          }
        }
      ],
      "viewport": {
        "x": 0,
        "y": 0,
        "zoom": 1
      }
    }
  },
