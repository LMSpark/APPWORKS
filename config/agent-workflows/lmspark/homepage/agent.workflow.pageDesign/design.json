          },
          "to": {
            "nodeId": "node.pageInventory",
            "modelId": "node.pageInventory.page",
            "memberName": "getFileText"
          },
          "type": "custom",
          "data": {
            "relation": "sequence",
            "branch": {
              "label": "sequence",
              "default": true
            },
            "validation": {}
          }
        },
        {
          "id": "line.2",
          "from": {
            "nodeId": "node.pageInventory",
            "modelId": "node.pageInventory.page",
            "memberName": "getFileText"
          },
          "to": {
            "nodeId": "node.dataShape",
            "modelId": "node.dataShape.workspace",
            "memberName": "loadScenarioViews"
          },
          "type": "custom",
          "data": {
            "relation": "sequence",
            "branch": {
              "label": "sequence",
              "default": true
            },
            "validation": {}
          }
        },
        {
          "id": "line.3",
          "from": {
            "nodeId": "node.dataShape",
            "modelId": "node.dataShape.views",
            "memberName": "value"
          },
