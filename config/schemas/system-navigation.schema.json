{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark-appworks.local/schemas/system-navigation.schema.json",
  "title": "SPARK AppWorks complete system blueprint source and published navigation selection",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "protocol": {"const": "spark-appworks.system-navigation"},
    "schemaVersion": {"const": 2},
    "navigationRootId": {"type": "string", "pattern": "^[A-F0-9]{32}$"},
    "publishedNodeIds": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-F0-9]{32}$"}
    },
    "records": {
      "type": "array",
      "minItems": 85,
      "maxItems": 85,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Manhour": {"type": ["number", "null"]},
          "NavigationUrl": {"type": ["string", "null"]},
          "funCode": {"type": ["string", "null"]},
          "Sum": {"type": ["number", "null"]},
          "personCharge": {"type": ["string", "null"]},
          "FunName": {"type": ["string", "null"]},
          "IsShowChildItem": {"type": ["number", "null"]},
          "Number": {"type": ["number", "null"]},
          "conid": {"type": ["string", "null"]},
          "MobileUrl": {"type": ["string", "null"]},
          "status": {"type": ["string", "null"]},
          "FunOrderValue": {"type": ["number", "null"]},
          "Total": {"type": ["number", "null"]},
          "memo": {"type": ["string", "null"]},
          "name": {"type": ["string", "null"]},
          "ChildItemLocation": {"type": ["string", "null"]},
          "SysId": {"type": "string", "pattern": "^[A-F0-9]{32}$"},
          "NavigationShowType": {"type": ["number", "null"]},
          "NavigationImageWxz": {"type": ["string", "null"]},
          "NavigationType": {"type": ["number", "string", "null"]},
          "conType": {"enum": ["Model", "Navitem"]},
          "rowid": {"type": "string", "pattern": "^[A-F0-9]{32}$"},
          "VersionId": {"type": ["string", "null"]},
          "IsShowAtNav": {"type": ["number", "null"]},
          "HorizontalAlignment": {"type": ["string", "null"]},
          "DifficultyFactor": {"type": ["number", "null"]},
          "prowid": {"type": "string", "pattern": "^(?:[A-F0-9]{32}|000000)$"},
          "htmlDesc": {"type": ["string", "null"]}
        },
        "required": ["Manhour", "NavigationUrl", "funCode", "Sum", "personCharge", "FunName", "IsShowChildItem", "Number", "conid", "MobileUrl", "status", "FunOrderValue", "Total", "memo", "name", "ChildItemLocation", "SysId", "NavigationShowType", "NavigationImageWxz", "NavigationType", "conType", "rowid", "VersionId", "IsShowAtNav", "HorizontalAlignment", "DifficultyFactor", "prowid", "htmlDesc"]
      }
    }
  },
  "required": ["protocol", "schemaVersion", "navigationRootId", "publishedNodeIds", "records"]
}
