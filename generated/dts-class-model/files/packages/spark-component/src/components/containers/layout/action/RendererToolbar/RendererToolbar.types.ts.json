    "RToolbarProps": {
      "name": "RToolbarProps",
      "jsdoc": "`RendererToolbar` 公开合同。容器工具栏及行/节点/列表项动作均复用它，\n由 children 和 tail.children 编排标准子组件，不另建操作列或按钮数组合同。\n未显式绑定时继承父 DataView 和行上下文；dataViewKey/dataMember/dataField 沿标准数据绑定解析。\n容器负责区域位置，RendererToolbar 负责子组件渲染、尾区、间距和 beforeRender。",
      "declarationKind": "typeAlias",
      "component": {
        "name": "RendererToolbar",
        "type": "r-toolbar",
        "level": "container",
        "layer": "layout-container",
        "directory": "containers/layout"
      },
      "typeAlias": {
