      "jsdoc": "查询执行器可选的来源适配；具体存储保留冲突、作用域及未知结果核验责任。",
      "declarationKind": "typeAlias",
      "typeAlias": {
        "declarationTypeText": "Readonly<{\n    /** 当前同一存储来源的全部视图，不只包含已查询视图；不同目标不能混入。 */\n    views(view: DataView): readonly DataView[];\n    /** 读取远端而不改变任何本地基线、查询结果或草稿。 */\n    preview(view: DataView): Promise<DataViewSourceSnapshot>;\n    /** 再读并核版本和原文；成功后紧邻同步应用前调用beforeApply，失败不得应用。 */\n    adopt(view: DataView, snapshot: DataViewSourceSnapshot, hooks: DataViewSourceAdoptHooks): Promise<void>;\n    /** 可选来源历史；不接纳历史内容、不保存或恢复DataView行。 */\n    history?: Readonly<{\n        /** 列出原存储版本，不构造本地版本号。 */ list(view: DataView): Promise<readonly DataViewSourceVersion[]>;\n        /** 预览指定历史原文；恢复须由对应语义资源转换成DataView变更并提交。 */ preview(view: DataView, version: string | number): Promise<string>;\n        /** 当前owner保存的原快照attempt状态；关闭面板和新建DataViewSource不清除它。 */ status(view: DataView): DataViewSourceHistoryStatus;\n        /** 只读核验status中的原编号和原文；即使后续同源DataView有草稿也可核验。 */\n        verify(view: DataView, hooks: Readonly<{\n            assertCurrent(): void;\n        }>): Promise<DataViewSourceHistoryStatus>;\n        /** 为干净已保存的来源创建快照；写入前调用onAttempt冻结候选编号，后续编辑不更换它。 */\n        create(view: DataView, hooks: Readonly<{\n            assertCurrent(): void;\n            onAttempt(attempt: DataViewSourceHistoryAttempt): void;\n        }>): Promise<void>;\n    }>;\n    /** 正文保存 owner 的不可变 attempt；允许同一 DataSet 资源视图重开后核验并交付原保存状态。 */\n    verifyWriteAttempt?(view: DataView, hooks: Readonly<{\n        assertCurrent(): void;\n    }>): Promise<DataViewSourceWriteAttemptStatus>;\n    acknowledgeWriteAttempt?(view: DataView): void;\n}>",
