+function deferred<T>() {
+  let complete: ((value: T) => void) | undefined
+  const promise = new Promise<T>(resolve => { complete = resolve })
+  return { promise, resolve: (value: T) => {
+    if (complete === undefined) throw new Error('promise resolver is missing')
+    complete(value)
+  } }
+}
