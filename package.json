{
    "name": "spark-appworks",
    "version": "0.3.0",
    "description": "SPARK 配置平台 - 深度配置 × 稳定运行时 × 受约束 AI 生成",
    "type": "module",
    "engines": {
        "node": ">=22.13.0",
        "pnpm": ">=10.0.0"
    },
    "packageManager": "pnpm@11.8.0",
    "scripts": {
        "dev": "vite",
        "search:value:noise": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/search-value-noise.ps1",
        "search:value:noise:summary": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/search-value-noise.ps1 -SummaryOnly",
        "build": "pnpm run build:packages && pnpm run build:fe",
        "build:fe": "node scripts/build-frontend.mjs",
        "build:packages": "node scripts/build-packages.mjs",
        "generate:class-model-surface": "pnpm exec tsx --no-cache scripts/generate-dts-class-model.mjs",
        "generate:class-model-surface:model": "pnpm exec tsx --no-cache scripts/generate-dts-class-model.mjs --model",
        "generate:lowcode-contracts": "node tools/lowcode-contracts/generate-ledgers.mjs",
        "ensure:class-model-bundle": "node scripts/ensure-class-model-bundle.mjs",
        "build:check": "pnpm run generate:class-model-surface && vue-tsc --noEmit --skipLibCheck && node scripts/build-frontend.mjs",
        "typecheck": "vue-tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json",
        "typecheck:strict": "vue-tsc --noEmit --strict --skipLibCheck -p tsconfig.typecheck.json",
        "lint": "eslint --cache .",
        "lint:strict": "eslint --cache \"**/*.{ts,vue,js}\" --max-warnings=0",
        "lint:fix": "eslint --cache . --fix",
        "preview": "vite preview --port 5273",
        "test": "vitest",
        "test:run": "vitest run",
        "test:run:threads": "vitest run --pool=threads --testTimeout=30000 --hookTimeout=30000",
        "test:all": "pnpm run test:run && pnpm run test:packages:run",
        "verify:arch": "node tools/verify-architecture.mjs",
        "verify:deps": "node tools/verify-dependency-catalog.mjs",
        "verify:pages-config": "node tools/verify-pages-config.mjs",
        "verify:ai-codegen": "node tools/verify-ai-codegen-rules.mjs",
        "verify:docs": "node tools/verify-docs.mjs",
        "verify:class-model": "pnpm run ensure:class-model-bundle && pnpm --filter @spark-appworks/spark-ai run lint && pnpm --filter @spark-appworks/spark-ai run typecheck && pnpm exec vitest run packages/spark-ai/src/class-model/tests/read-dts-class-model-bundle-json.test.ts packages/spark-ai/src/class-model/tests/class-model-tool-schema-recovery.test.ts tests/scripts/class-model-bundle-assert.test.ts tests/scripts/class-model-incremental-build.test.ts",
        "verify:class-model:full": "pnpm run generate:class-model-surface && node scripts/verify-class-model-guide-json-schema.mjs && node scripts/verify-class-model-semantic-gaps.mjs && pnpm run verify:class-model && pnpm run typecheck",
        "verify:page-design": "node scripts/verify-page-design-offline.mjs",
        "verify:project-planning": "node scripts/verify-project-planning-offline.mjs",
        "verify:model-convergence": "node scripts/verify-model-convergence-offline.mjs",
        "verify:project-blueprint-ssot": "node tools/verify-project-blueprint-ssot.mjs",
        "verify:ajax-result-parity": "node tools/verify-ajax-result-parity.mjs",
        "verify:send-code-parity": "node tools/verify-send-code-type-parity.mjs",
        "verify:send-code-type-parity": "pnpm run verify:send-code-parity",
        "verify:wire-query-parity": "node tools/verify-wire-query-parity.mjs",
        "verify:workflow-designs": "node tools/verify-workflow-designs.mjs",
        "verify:lowcode-contracts": "node tools/lowcode-contracts/generate-ledgers.mjs --check",
        "verify:ai-business-boundaries": "node scripts/verify-ai-business-boundaries.mjs",
        "verify:ai-model": "node tools/verify-ai-model-spec.mjs",
        "verify:ai-model:strict": "node tools/verify-ai-model-spec.mjs --strict",
        "verify:ai-model:schema": "node tools/verify-ai-model-schema.mjs",
        "verify:dirs": "node tools/verify-directory-limits.mjs",
        "verify:rules": "pnpm run verify:arch && pnpm run verify:deps && pnpm run verify:pages-config && pnpm run verify:ai-codegen && pnpm run verify:docs && pnpm run verify:class-model && pnpm run verify:workflow-designs && pnpm run verify:lowcode-contracts && pnpm run verify:ai-model && pnpm run verify:project-blueprint-ssot && pnpm run verify:ajax-result-parity && pnpm run verify:send-code-parity && pnpm run verify:wire-query-parity && pnpm run verify:dirs",
        "verify": "pnpm run typecheck && pnpm run lint && pnpm run verify:rules",
        "verify:dist": "pnpm run build:packages && pnpm run typecheck && pnpm run lint && pnpm run verify:rules",
        "publish:packages": "node scripts/publish-packages.mjs",
        "publish:dry": "node scripts/publish-packages.mjs --dry-run",
        "lint:packages": "pnpm --filter 'packages/*' run lint",
        "lint:fix:packages": "pnpm --filter 'packages/*' run lint:fix",
        "test:packages": "pnpm --filter 'packages/*' run test",
        "test:packages:run": "pnpm -r --filter=@spark-appworks/* run test:run",
        "typecheck:packages": "pnpm --filter 'packages/*' run typecheck"
    },
    "dependencies": {
        "@element-plus/icons-vue": "catalog:",
        "@vue-flow/background": "catalog:",
        "@vue-flow/controls": "catalog:",
        "@vue-flow/core": "catalog:",
        "@vue-flow/minimap": "catalog:",
        "@spark-appworks/spark-ai": "workspace:*",
        "@spark-appworks/spark-app": "workspace:*",
        "@spark-appworks/spark-component": "workspace:*",
        "@spark-appworks/spark-data": "workspace:*",
        "@spark-appworks/spark-json-document": "workspace:*",
        "@spark-appworks/spark-lowcode-api": "workspace:*",
        "@spark-appworks/spark-project-model": "workspace:*",
        "@spark-appworks/spark-utils": "workspace:*",
        "element-plus": "catalog:",
        "vue": "catalog:",
        "vue-router": "catalog:",
        "vxe-table": "catalog:"
    },
    "devDependencies": {
        "@eslint/js": "catalog:",
        "@spark-appworks/vite-plugin-spark-catalog": "workspace:*",
        "@types/node": "catalog:",
        "@typescript-eslint/eslint-plugin": "catalog:",
        "@typescript-eslint/parser": "catalog:",
        "@vitejs/plugin-vue": "catalog:",
        "@vue/language-core": "catalog:",
        "@vue/test-utils": "catalog:",
        "eslint": "catalog:",
        "eslint-plugin-vue": "catalog:",
        "glob": "^13.0.6",
        "jsdom": "^29.1.1",
        "tsx": "^4.22.4",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "vue-eslint-parser": "catalog:",
        "vue-tsc": "catalog:"
    }
}