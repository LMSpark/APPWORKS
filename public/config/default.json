{
    "configSource": {
        "type": "local",
        "local": {
            "defaultConfigPath": "/config/default.json",
            "tenantConfigTemplate": "/config/tenants/tenant-{tenantId}.json"
        }
    },
    "router": {
        "mode": "history"
    },
    "mountTarget": "#app",
    "plugins": {
        "element-plus": {
            "enabled": true,
            "options": {
                "size": "default",
                "zIndex": 2000
            },
            "priority": 1
        },
        "vxe-table": {
            "enabled": true,
            "priority": 2
        }
    },
    "spark": {
        "enabled": true
    },
    "pageNode": {
        "source": "local",
        "apiBaseUrl": "/api",
        "homePath": "/home"
    },
    "config": {
        "apiBaseUrl": "/api",
        "logLevel": "debug",
        "enableMock": true,
        "version": "1.0.0",
        "features": {
            "enableAI": true,
            "enableExport": true,
            "enableOffline": false
        }
    },
    "logger": {
        "level": "debug",
        "enableColors": true,
        "showTimestamp": true,
        "enableRemote": true,
        "remoteEndpoint": "/api/logs",
        "minRemoteLevel": "debug",
        "batchSize": 50,
        "flushInterval": 5000
    }
}
