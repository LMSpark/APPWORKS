[
  {
    "id": "authoring-content",
    "type": "r-section",
    "props": {"title": "标书正文编制", "gridColumns": 1, "onBeforeRender": "bindEditorStatus"},
    "children": [
      {"type": "r-button", "props": {"label": "查看分册策划依据", "onBeforeRender": "bindVolumePlanning", "onClick": "openVolumePlanning"}},
      {"type": "r-button", "props": {"label": "核对原表映射", "onBeforeRender": "bindOriginalForm", "onClick": "openOriginalForm"}},
      {"type": "r-button", "props": {"label": "核对换表差异", "onBeforeRender": "bindOriginalFormComparison", "onClick": "openOriginalFormComparison"}},
      {"type": "r-button", "props": {"label": "回查原采用记录", "onBeforeRender": "bindOriginalAdoption", "onClick": "openOriginalAdoption"}},
      {"type": "r-button", "props": {"label": "预演候选变更", "onBeforeRender": "bindCandidatePreview", "onClick": "openCandidatePreview"}},
      {"type": "r-button", "props": {"label": "核对候选生成输入", "onBeforeRender": "bindDraftCandidate", "onClick": "openDraftCandidate"}},
      {
        "id": "original-draft",
        "type": "r-form",
        "props": {
          "dataViewKey": "D3BBA1F0780056C837AC35E9825CAD5A@WorkingDraft@personalDraft",
          "autoColumns": false,
          "onBeforeRender": "bindOriginalDraft"
        },
        "children": [
          {"type": "r-text", "props": {"label": "工作草稿", "readonly": true, "onBeforeRender": "bindDraftIdentity"}},
          {"type": "r-button", "props": {"label": "新增逻辑册", "permAction": "edit", "onBeforeRender": "bindAddDocument"}},
          {"type": "r-button", "props": {"label": "新增章节", "permAction": "edit", "onBeforeRender": "bindAddChapter"}},
          {"type": "r-button", "props": {"label": "新增段落", "permAction": "edit", "onBeforeRender": "bindAddParagraph"}},
          {"type": "r-button", "props": {"label": "新增项目符号列表", "permAction": "edit", "onBeforeRender": "bindAddList"}},
          {"type": "r-button", "props": {"label": "新增编号列表", "permAction": "edit", "onBeforeRender": "bindAddOrderedList"}},
          {"type": "r-button", "props": {"label": "新增列表项", "permAction": "edit", "onBeforeRender": "bindAddListItem"}},
          {"type": "r-button", "props": {"label": "新增引文", "permAction": "edit", "onBeforeRender": "bindAddQuote"}},
          {"type": "r-button", "props": {"label": "新增普通表", "permAction": "edit", "onBeforeRender": "bindAddTable"}},
          {"type": "r-button", "props": {"label": "新增目录", "permAction": "edit", "onBeforeRender": "bindAddToc"}},
          {"type": "r-button", "props": {"label": "删除所选子树", "permAction": "edit", "onBeforeRender": "bindRemove"}},
          {"type": "r-button", "props": {"label": "上移", "permAction": "edit", "onBeforeRender": "bindMoveUp"}},
          {"type": "r-button", "props": {"label": "下移", "permAction": "edit", "onBeforeRender": "bindMoveDown"}},
          {"type": "r-button", "props": {"label": "取消本次草稿编辑", "onBeforeRender": "bindCancel", "onClick": "cancelDraft"}},
          {
            "id": "content-outline",
            "type": "r-json",
            "props": {
              "field": "draft", "dataMember": "currentRow", "valueFormat": "text", "valuePath": ["nodes"],
              "mode": "outline", "outlineIdField": "nodeId", "outlineParentField": "parentId",
              "readonly": true, "onBeforeRender": "bindContentOutline", "onSelectedPathChange": "selectContentNode"
            },
            "children": [
              {"type": "r-text", "props": {"field": "type", "label": "类型", "readonly": true}},
              {"type": "r-text", "props": {"field": "value", "label": "内容", "readonly": true}}
            ]
          },
          {
            "id": "selected-content",
            "type": "r-section",
            "props": {"title": "所选内容", "status": "选择节点查看原始内容和引用"},
            "children": [
              {"id": "selected-node-json", "type": "r-json", "props": {
                "field": "draft", "dataMember": "currentRow", "valueFormat": "text", "mode": "tree",
                "readonly": true, "onBeforeRender": "bindSelectedNode"
              }}
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "original-draft-save",
    "type": "r-section",
    "props": {"title": "原保存结果", "onBeforeRender": "bindOriginalSave"},
    "children": [
      {"type": "r-button", "props": {"label": "重查原保存结果", "onBeforeRender": "bindRefreshOriginalSave", "onClick": "refreshOriginalSave"}}
    ]
  }
]
