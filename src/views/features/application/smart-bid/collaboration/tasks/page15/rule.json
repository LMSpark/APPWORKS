      {"type":"r-button","props":{"label":"回查原问题登记","action":"host-command","command":"bid.tasks.readFindingRegistration","input":{"checkRef":{"$route":"findingCheckRef"},"requestKey":{"$route":"findingRegistrationKey"},"requestDigest":{"$route":"findingRegistrationDigest"}},"routeQueryRequired":["findingCheckRef","findingRegistrationKey","findingRegistrationDigest"],"resultAlertTitle":"原问题登记结果"}},
      {"type":"r-button","props":{"label":"提交问题或检查覆盖登记","action":"host-command","command":"smart-bid.dispatch","input":{"operationId":"43","requestKey":{"$route":"findingRegistrationKey"},"prompt":"登记问题","inputs":{"checkRef":{"$route":"findingCheckRef"}}},"routeQueryRequired":["findingCheckRef","findingRegistrationKey"],"successMessage":"问题登记已提交"}},
