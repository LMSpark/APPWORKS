      {"type":"r-button","props":{"label":"提交问题复验","action":"host-command","command":"smart-bid.dispatch","input":{"operationId":"44","requestKey":{"$route":"recheckRequestKey"},"prompt":"复验问题","inputs":{"findingId":{"$route":"findingId"},"expectedFindingVersion":{"$route":"expectedFindingVersion"}}},"routeQueryRequired":["findingId","expectedFindingVersion","recheckRequestKey"],"successMessage":"问题复验已提交"}}
