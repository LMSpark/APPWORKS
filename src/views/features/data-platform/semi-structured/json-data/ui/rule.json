[
  {
    "id": "json-data-catalog",
    "type": "r-section",
    "props": {"title": "JSON 文件数据管理", "class": "json-data-catalog", "bordered": false, "gridColumns": 1, "onBeforeRender": "bindCatalogSection"},
    "children": [
      {"type": "r-button", "props": {"label": "新增", "onBeforeRender": "bindCatalogCreate", "onClick": "createJsonDocument"}},
      {"type": "r-button", "props": {"label": "导入JSON", "onBeforeRender": "bindCatalogCreate", "onClick": "importJsonDocument"}},
      {"type": "r-button", "props": {"label": "保存目录", "onBeforeRender": "bindCatalogSave", "onClick": "saveJsonCatalog"}},
      {"type": "r-button", "props": {"label": "取消目录修改", "onBeforeRender": "bindCatalogCancel", "onClick": "cancelJsonCatalog"}},
      {
        "id": "json-data-definitions",
        "type": "r-table",
        "props": {
          "dataViewKey": "FFDEF2AED3E19A38C0FCDDC748CF939B@Base_JsonData@default",
          "border": true,
          "stripe": true,
          "showRowIndex": true,
          "showDataViewMeta": false,
          "onRowClick": "openJsonDocument"
        },
        "children": [
          {"type": "r-text", "props": {"field": "name", "label": "名称", "maxlength": 200, "minWidth": 220, "onBeforeRender": "bindCatalogField"}},
          {"type": "r-text", "props": {"field": "description", "label": "摘要", "maxlength": 500, "minWidth": 220, "onBeforeRender": "bindCatalogField"}}
        ]
      },
      {
        "id": "json-document-create-metadata",
        "type": "r-form",
        "props": {"autoColumns": false, "showDataViewMeta": false, "onBeforeRender": "bindCreationMetadata"},
        "children": [
          {"type":"r-text","props":{"field":"name","label":"名称","maxlength":200,"onBeforeRender":"bindCreationField"}},
          {"type":"r-text","props":{"field":"description","label":"摘要","maxlength":500,"onBeforeRender":"bindCreationField"}}
        ]
      },
      {
        "id": "json-document-preview",
        "type": "r-form",
        "props": {"autoColumns": false, "showDataViewMeta": false, "onBeforeRender": "bindJsonDocument"},
        "children": [
          {"type": "r-json", "props": {"field": "content", "label": "JSON 内容", "mode": "tree", "onBeforeRender": "bindJsonField", "onEditingChange": "trackJsonInput"}},
          {"type": "r-button", "props": {"label": "保存内容", "onBeforeRender": "bindJsonSave", "onClick": "saveJsonDocument"}},
          {"type": "r-button", "props": {"label": "取消修改", "onBeforeRender": "bindJsonCancel", "onClick": "cancelJsonDocument"}},
          {"type": "r-button", "props": {"label": "关闭正文", "onClick": "closeJsonDocument"}}
        ]
      }
    ]
  }
]
