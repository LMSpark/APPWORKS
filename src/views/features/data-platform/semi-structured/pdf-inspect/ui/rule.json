[
  {
    "id":"pdf-catalog-actions",
    "type":"r-space",
    "props":{"wrap":true},
    "children":[
      {"type":"r-button","props":{"label":"新增规则","onBeforeRender":"bindCreateRule","onClick":"createRule"}},
      {"type":"r-button","props":{"label":"打开设计","icon":"Setting","onBeforeRender":"bindOpenDesign","onClick":"openDesign"}},
      {"type":"r-button","props":{"label":"核验准备","onBeforeRender":"bindPrepareInspection","onClick":"prepareInspection"}},
      {"type":"r-button","props":{"label":"刷新","icon":"Refresh","onBeforeRender":"bindRefreshCatalog","onClick":"refreshCatalog"}},
      {"type":"r-button","props":{"label":"核验历史","onBeforeRender":"bindOpenHistory","onClick":"openHistory"}}
    ]
  },
  {"type":"r-space","props":{"wrap":true,"onBeforeRender":"bindPendingRequests"}},
  {"type":"r-section","props":{"bordered":false,"status":"请进入已授权应用后设计规则或发起核验。","onBeforeRender":"bindCatalogScope"}},
  {
    "id":"pdf-inspect-rule-catalog",
    "type":"r-table",
    "props":{"dataViewKey":"A2D63AB2AAEF156E7727094A23AEA433@Base_FileInspectConfig@default","class":"pdf-rule-catalog-table",
      "stripe":true,"border":true,"highlightCurrentRow":true,"showDataViewMeta":false,"onRowClick":"selectRule"},
    "children":[
      {"type":"r-text","props":{"field":"name","label":"规则名称","minWidth":240,"showOverflowTooltip":true}},
      {"type":"r-text","props":{"field":"description","label":"描述","minWidth":300,"showOverflowTooltip":true}},
      {"type":"r-text","props":{"field":"enabled","label":"启用状态","width":120}}
    ]
  },
  {
    "id":"pdf-rule-creation",
    "type":"r-dialog",
    "props":{"title":"新增PDF核验规则","width":660,"appendToBody":true,"onBeforeRender":"bindCreationDialog","on":{"update:modelValue":"closeCreation"},
      "footer":{"children":[
        {"type":"r-button","props":{"onBeforeRender":"bindCreationCancel","onClick":"cancelCreation"}},
        {"type":"r-button","props":{"buttonType":"primary","onBeforeRender":"bindCreationSubmit","onClick":"submitCreation"}}
      ]}},
    "children":[
      {"type":"r-section","props":{"bordered":false,"onBeforeRender":"bindCreationStatus"}},
      {"type":"r-form","props":{"autoColumns":false,"showDataViewMeta":false,"gridColumns":1,"onBeforeRender":"bindCreationForm"},"children":[
        {"type":"r-text","props":{"field":"name","label":"规则名称","onBeforeRender":"bindCreationField"}},
        {"type":"r-text","props":{"field":"description","label":"描述","onBeforeRender":"bindCreationField"}},
        {"type":"r-textarea","props":{"field":"rule_config","label":"规则JSON","onBeforeRender":"bindCreationField"}},
        {"type":"r-radio","props":{"field":"enabled","label":"启用","options":[{"value":0,"label":"停用"},{"value":1,"label":"启用"}],"onBeforeRender":"bindCreationField"}}
      ]}
    ]
  },
  {
    "id":"pdf-inspection-preparation",
    "type":"r-section",
    "props":{"title":"核验准备","bordered":false,"onBeforeRender":"bindPreparation"},
    "children":[
      {"type":"r-form","props":{"autoColumns":false,"showDataViewMeta":false,"onBeforeRender":"bindLimits"},"children":[
        {"type":"r-number","props":{"field":"maxFiles","label":"最多文件数","readonly":true}},
        {"type":"r-number","props":{"field":"maxFileBytes","label":"单文件字节上限","readonly":true}},
        {"type":"r-number","props":{"field":"maxTotalFileBytes","label":"文件总字节上限","readonly":true}}
      ]},
      {"type":"r-space","props":{"wrap":true},"children":[
        {"type":"r-button","props":{"label":"选择 PDF 或 ZIP","onBeforeRender":"bindSelectFiles","onClick":"selectInspectionFiles"}},
        {"type":"r-button","props":{"buttonType":"primary","onBeforeRender":"bindSubmitInspection","onClick":"submitInspection"}},
        {"type":"r-button","props":{"label":"取消所选文件","onBeforeRender":"bindCancelFiles","onClick":"cancelInspectionFiles"}},
        {"type":"r-button","props":{"label":"复制原请求恢复链接","onBeforeRender":"bindCopyRecovery","onClick":"copyInspectionRecoveryLink"}}
      ]},
      {"type":"r-table","props":{"showDataViewMeta":false,"onBeforeRender":"bindInspectionUploads"},"children":[
        {"type":"r-text","props":{"field":"originalName","label":"文件名称","readonly":true}},
        {"type":"r-number","props":{"field":"size","label":"字节数","readonly":true}}
      ]},
      {"type":"r-section","props":{"bordered":false,"onBeforeRender":"bindExecutionMessage"}}
    ]
  },
  {
    "id":"pdf-inspection-history",
    "type":"r-section",
    "props":{"title":"核验历史","bordered":false,"onBeforeRender":"bindHistory"},
    "children":[
      {"type":"r-table","props":{"showDataViewMeta":false,"onBeforeRender":"bindHistoryTable","onRowClick":"openHistoryResult"},"children":[
        {"type":"r-text","props":{"field":"inspectJobId","label":"任务编号","readonly":true}},
        {"type":"r-text","props":{"field":"requestId","label":"请求编号","readonly":true}},
        {"type":"r-text","props":{"field":"configId","label":"规则编号","readonly":true}},
        {"type":"r-text","props":{"field":"status","label":"处理状态","readonly":true}}
      ]}
    ]
  },
  {
    "id":"pdf-inspection-result",
    "type":"r-section",
    "props":{"bordered":false,"onBeforeRender":"bindResult"},
    "children":[
      {"type":"r-button","props":{"label":"重新核验原请求","onBeforeRender":"bindRecover","onClick":"recoverOriginal"}},
      {"type":"r-form","props":{"autoColumns":false,"showDataViewMeta":false,"onBeforeRender":"bindResultForm"},"children":[
        {"type":"r-text","props":{"field":"inspectJobId","label":"任务编号","readonly":true}},
        {"type":"r-text","props":{"field":"requestId","label":"请求编号","readonly":true}},
        {"type":"r-text","props":{"field":"status","label":"处理状态","readonly":true}},
        {"type":"r-number","props":{"field":"finished","label":"已处理文件数","readonly":true}},
        {"type":"r-number","props":{"field":"total","label":"文件总数","readonly":true}},
        {"type":"r-json","props":{"field":"files","label":"文件与规则核验明细","mode":"text","valueFormat":"native","readonly":true}}
      ]}
    ]
  }
]
