                  "onClick": "openRun"
                }
              },
              {
                "id": "openDetail",
                "type": "r-button",
                "props": {
                  "label": "运行详情",
                  "onClick": "openDetail"
                }
              }
            ],
            "props": {
              "onBeforeRender": "bindPrepared"
            }
          }
        ]
      }
    },
    "children": [
      {
        "id": "businessDetailTitle",
        "type": "RenderBusinessDetailTitle",
        "props": {
          "className": "bus-flow-detail-page__title"
        }
      },
      {
        "id": "summary",
        "type": "r-table",
        "props": {
          "class": "bus-flow-detail-summary",
          "dataViewKey": "E328FBBF518141973C575D612CD75151@WFOBJ_FLOW@default",
          "stripe": true,
          "showDataViewMeta": false,
          "onBeforeRender": "bindPrepared"
        },
        "children": [
          {
            "type": "r-text",
            "props": {
              "field": "TITLE",
              "label": "流程标题",
              "readonly": true,
              "minWidth": 200
            }
          },
          {
            "type": "r-text",
            "props": {
              "field": "status",
