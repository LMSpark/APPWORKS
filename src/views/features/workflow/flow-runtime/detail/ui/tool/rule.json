[
  {
    "id": "runtimeDetail",
    "type": "r-section",
    "props": {
      "class": "flow-run-detail-page",
      "title": "流程运行详情",
      "bordered": false,
      "gridColumns": 1,
      "gridGap": 12,
      "onBeforeRender": "bindDetail",
      "on": {
        "retry": "retryDetail"
      },
      "header": {
        "children": [
          {
            "id": "openRun",
            "type": "r-button",
            "props": {
              "label": "前往办理",
              "buttonType": "primary",
              "onClick": "openRun",
              "onBeforeRender": "bindOpenRun"
            }
          }
        ]
      }
    },
    "children": [
      {
        "id": "instanceIdentity",
        "type": "r-alert",
        "props": {
          "alertType": "info",
          "closable": false,
          "showIcon": true,
          "onBeforeRender": "bindIdentity"
        }
      },
      {
        "id": "summary",
        "type": "r-table",
        "props": {
          "class": "flow-run-detail-summary",
          "dataViewKey": "E328FBBF518141973C575D612CD75151@View_FlowObjList@default",
          "stripe": true,
          "showDataViewMeta": false
        },
        "children": [
          {
            "type": "r-text",
            "props": {
              "field": "TITLE",
              "label": "流程标题",
              "readonly": true,
              "minWidth": 220
            }
          },
          {
            "type": "r-text",
            "props": {
              "field": "AppDesc",
              "label": "应用名称",
              "readonly": true,
              "minWidth": 160
            }
          },
          {
            "type": "r-select",
            "props": {
              "field": "status",
              "label": "状态",
              "readonly": true,
              "minWidth": 120,
              "optionDataViewKey": "E328FBBF518141973C575D612CD75151@Dict_state@default"
            }
          },
          {
            "type": "r-text",
            "props": {
              "field": "handleInfo",
              "label": "办理信息",
              "readonly": true,
              "minWidth": 200
            }
          }
        ]
      },
      {
        "id": "runTrace",
        "type": "r-section",
        "props": {
          "title": "运行轨迹",
          "bordered": true,
          "gridColumns": 1,
          "gridGap": 8
        },
        "children": [
          {
            "id": "runLegend",
            "type": "r-text-display",
            "props": {
              "class": "flow-run-detail-page__legend",
              "text": "已完成（绿徽标）· 待办（橙徽标）· 只读预览"
            }
          },
          {
            "id": "runGraph",
            "type": "r-graph",
            "props": {
              "class": "flow-run-detail-page__graph",
              "labelField": "TITLE",
              "descriptionField": "MEMO",
              "nodeCaptionField": "TYPEID",
              "edgeSourceField": "UpNodeID",
              "edgeTargetField": "NextNodeID",
              "backgroundPattern": "dots",
              "nodeAppearance": "card",
              "viewportControls": true,
              "disabled": true,
              "onBeforeRender": "bindGraph"
            }
          },
          {
            "id": "runGraphUnavailable",
            "type": "r-alert",
            "props": {
              "alertType": "info",
              "closable": false,
              "showIcon": true,
              "title": "运行图尚未加载。",
              "onBeforeRender": "bindGraphUnavailable"
            }
          }
        ]
      },
      {
        "id": "stepDrilldowns",
        "type": "RenderFlowStepDrilldowns",
        "props": {
          "node": {
            "id": "nodeSteps",
            "type": "r-dialog",
            "props": {
              "width": 960,
              "appendToBody": true,
              "destroyOnClose": true
            },
            "children": [
              {
                "type": "r-checkbox",
                "props": {
                  "checkboxText": "显示作废信息",
                    "style": { "marginBottom": "8px" }
                }
              },
              {
                "type": "r-tabs",
                "children": [
                  {
                    "type": "r-tab-pane",
                    "props": {
                      "name": "received",
                      "label": "提交到当前节点",
                      "lazy": true
                    }
                  },
                  {
                    "type": "r-tab-pane",
                    "props": {
                      "name": "sent",
                      "label": "当前节点提交的",
                      "lazy": true
                    }
                  },
                  {
                    "type": "r-tab-pane",
                    "props": {
                      "name": "all",
                      "label": "所有信息",
                      "lazy": true
                    }
                  }
                ]
              }
            ]
          },
          "edge": {
            "id": "edgeSteps",
            "type": "r-dialog",
            "props": {
              "width": 960,
              "appendToBody": true,
              "destroyOnClose": true
            },
            "children": [
              {
                "type": "r-checkbox",
                "props": {
                  "checkboxText": "显示作废信息",
                    "style": { "marginBottom": "8px" }
                }
              },
              {
                "type": "r-tabs",
                "children": [
                  {
                    "type": "r-tab-pane",
                    "props": {
                      "name": "edge",
                      "label": "连线步骤",
                      "lazy": true
                    }
                  },
                  {
                    "type": "r-tab-pane",
                    "props": {
                      "name": "all",
                      "label": "所有信息",
                      "lazy": true
                    }
                  }
                ]
              }
            ]
          },
          "stepTable": {
            "id": "stepTable",
            "type": "r-table",
            "props": {
              "stripe": true,
              "maxHeight": 380,
              "showPagination": false,
              "showDataViewMeta": false
            },
            "children": [
              {
                "type": "r-column-group",
                "props": {"title": "摘要", "minWidth": 280},
                "children": [
                  {"type": "r-text-display", "props": {"field": "description"}},
                  {"type": "r-tag", "props": {"content": "待办", "tagType": "warning", "size": "small", "style": {"marginLeft": "8px"}, "onBeforeRender": "bindWaitingStep"}}
                ]
              },
              {
                "type": "r-text",
                "props": {
                  "field": "STARTTIME",
                  "label": "开始时间",
                  "sortable": "custom",
                  "minWidth": 160,
                  "readonly": true
                }
              },
              {
                "type": "r-select",
                "props": {
                  "field": "StepState",
                  "label": "步骤状态",
                  "optionDataViewKey": "A5BADCEE11D2438CB9E75C2453A220A6@AppendStepStates@default",
                  "optionValueField": "value",
                  "optionLabelField": "label",
                  "optionNumericText": true,
                  "minWidth": 100,
                  "readonly": true
                }
              }
            ]
          }
        }
      }
    ]
  }
]
