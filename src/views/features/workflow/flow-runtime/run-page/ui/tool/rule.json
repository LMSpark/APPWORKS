[
  {
    "id": "workflowRun",
    "type": "r-section",
    "props": {
      "class": "flow-run-page",
      "title": "流程办理",
      "bordered": false,
      "gridColumns": 1,
      "onBeforeRender": "bindShell",
      "on": {
        "retry": "retryWorkflow"
      },
      "header": {
        "children": [
          {
            "id": "workflowActions",
            "type": "RenderWorkflowActions",
            "props": {
              "bar": {
                "id": "pageActions",
                "type": "r-toolbar",
                "props": {
                  "wrap": true,
                  "gap": 8
                },
                "children": [
                  {
                    "type": "r-button",
                    "id": "chart",
                    "props": {
                      "label": "流程图",
                      "onClick": "runChart"
                    }
                  },
                  {
                    "type": "r-button",
                    "id": "append",
                    "props": {
                      "label": "加签",
                      "onClick": "runAppend"
                    }
                  },
                  {
                    "type": "r-button",
                    "id": "revoke",
                    "props": {
                      "label": "撤回",
                      "onClick": "runRevoke"
                    }
                  },
                  {
                    "type": "r-button",
                    "id": "handle",
                    "props": {
                      "label": "办理",
                      "buttonType": "primary",
                      "onClick": "runHandle"
                    }
                  },
                  {
                    "type": "r-button",
                    "id": "verify",
                    "props": {
                      "label": "核验原办理结果",
                      "onClick": "runVerify"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "children": [
      {
        "id": "retryNavigation",
        "type": "r-button",
        "props": {
          "label": "切换到当前导航",
          "onClick": "retryWorkflow",
          "onBeforeRender": "bindNavigationRetry"
        }
      },
      {
        "id": "workflowLayout",
        "type": "RenderWorkflowLayout",
        "props": {
          "layoutClass": "flow-run-page__layout",
          "mobileClass": "flow-run-page__layout--mobile",
          "business": {
            "className": "flow-run-page__business",
            "titleClass": "flow-run-page__title",
            "empty": {
              "description": "未查询到业务页签"
            },
            "error": {
              "alertType": "error",
              "closable": false,
              "showIcon": true
            },
            "tabs": {
              "id": "businessFormTabs",
              "type": "r-tabs",
              "props": {
                "class": "flow-run-page__tabs"
              },
              "children": [
                {
                  "id": "businessFormPane",
                  "type": "r-tab-pane",
                  "props": {
                    "lazy": true
                  }
                }
              ]
            }
          },
          "history": {
            "type": "r-section",
            "props": {
              "title": "步骤历史",
              "class": "flow-run-history",
              "bordered": false,
              "gridColumns": 1
            },
            "children": [
              {
                "type": "r-table",
                "props": {
                  "dataViewKey": "A5BADCEE11D2438CB9E75C2453A220A6@WFOBJ_FLOW_RELATIONLINE_STEP@default",
                  "stripe": true,
                  "showDataViewMeta": false,
                  "pagination": {
                    "pageSizes": [
                      10,
                      20,
                      50
                    ],
                    "showJumper": true
                  }
                },
                "children": [
                  {
                    "type": "r-text",
                    "props": {
                      "field": "description",
                      "label": "摘要",
                      "readonly": true,
                      "minWidth": 220,
                      "showOverflowTooltip": true
                    }
                  },
                  {
                    "type": "r-text",
                    "props": {
                      "field": "ReceiveUserName",
                      "label": "办理人",
                      "readonly": true,
                      "minWidth": 120
                    }
                  },
                  {
                    "type": "r-text",
                    "props": {
                      "field": "STARTTIME",
                      "label": "开始时间",
                      "readonly": true,
                      "minWidth": 160
                    }
                  },
                  {
                    "type": "r-text",
                    "props": {
                      "field": "StepState",
                      "label": "状态",
                      "readonly": true,
                      "minWidth": 80
                    }
                  }
                ]
              }
            ],
            "id": "history"
          },
          "approval": {
            "className": "flow-run-page__handle",
            "section": {
              "type": "r-section",
              "id": "approvalSection",
              "props": {
                "title": "办理",
                "bordered": false,
                "gridColumns": 1
              }
            },
            "nodes": {
              "id": "approvalNodes",
              "type": "r-table",
              "props": {
                "dataViewKey": "A5BADCEE11D2438CB9E75C2453A220A6@ApprovalNodeInput@default",
                "autoColumns": false,
                "showPagination": false,
                "showDataViewMeta": false
              },
              "children": [
                {
                  "type": "r-column-group",
                  "props": {
                    "title": "选择"
                  },
                  "children": [
                    {
                      "type": "r-checkbox",
                      "props": {
                        "field": "selected",
                        "label": "",
                        "saveOnCellExit": false
                      }
                    }
                  ]
                },
                {
                  "type": "r-text",
                  "props": {
                    "field": "title",
                    "label": "下一节点",
                    "readonly": true
                  }
                },
                {
                  "type": "r-column-group",
                  "props": {
                    "title": "办理人"
                  },
                  "children": [
                    {
                      "type": "r-user-picker",
                      "props": {
                        "field": "ExecUserList",
                        "multiple": true,
                        "valueMode": "array",
                        "readonly": "$[peopleReadonly]",
                        "optionValueField": "value",
                        "optionLabelField": "name",
                        "editOnDblclick": false,
                        "label": "",
                        "saveOnCellExit": false,
                        "optionDataViewKey": "$[candidateViewKey]"
                      }
                    }
                  ]
                },
                {
                  "type": "r-column-group",
                  "props": {
                    "title": "返回原办理人"
                  },
                  "children": [
                    {
                      "type": "r-checkbox",
                      "props": {
                        "field": "checkedReturn",
                        "readonly": "$[returnReadonly]",
                        "label": "",
                        "saveOnCellExit": false
                      }
                    }
                  ]
                }
              ]
            },
            "input": {
              "id": "approvalInput",
              "type": "r-form",
              "props": {
                "dataViewKey": "A5BADCEE11D2438CB9E75C2453A220A6@ApprovalInput@default",
                "autoColumns": false,
                "showDataViewMeta": false
              },
              "children": [
                {
                  "type": "r-textarea",
                  "props": {
                    "field": "idea",
                    "label": "办理意见",
                    "rows": 4
                  }
                },
                {
                  "type": "r-select",
                  "props": {
                    "field": "forceNodeId",
                    "optionDataViewKey": "A5BADCEE11D2438CB9E75C2453A220A6@ApprovalForceTargets@default",
                    "label": "强制退回目标",
                    "optionValueField": "id",
                    "optionLabelField": "title"
                  }
                },
                {
                  "type": "r-checkbox",
                  "props": {
                    "field": "notifySms",
                    "label": "短信通知"
                  }
                },
                {
                  "type": "r-checkbox",
                  "props": {
                    "field": "notifyQywx",
                    "label": "企业微信通知"
                  }
                },
                {
                  "type": "r-checkbox",
                  "props": {
                    "field": "notifyDingTalk",
                    "label": "钉钉通知"
                  }
                },
                {
                  "type": "r-checkbox",
                  "props": {
                    "field": "notifyWechat",
                    "label": "微信通知"
                  }
                }
              ]
            },
            "actions": {
              "id": "approvalActions",
              "type": "r-toolbar",
              "props": {
                "wrap": true,
                "gap": 8
              },
              "children": [
                {
                  "type": "r-button",
                  "id": "submit",
                  "props": {
                    "label": "提交",
                    "buttonType": "primary",
                    "onClick": "runSubmit"
                  }
                },
                {
                  "type": "r-button",
                  "id": "back",
                  "props": {
                    "label": "普通退回",
                    "onClick": "runBack"
                  }
                },
                {
                  "type": "r-button",
                  "id": "forceBack",
                  "props": {
                    "label": "强制退回",
                    "onClick": "runForceBack"
                  }
                },
                {
                  "type": "r-button",
                  "id": "backToCreator",
                  "props": {
                    "label": "退回发起人",
                    "onClick": "runBackToCreator"
                  }
                },
                {
                  "type": "r-button",
                  "id": "close",
                  "props": {
                    "label": "关闭",
                    "onClick": "runClose"
                  }
                }
              ]
            }
          },
          "mobilePanels": {
            "history": {
              "title": "步骤历史",
              "fullscreen": true,
              "fullscreenable": false,
              "appendToBody": true,
              "destroyOnClose": true,
              "closeOnClickModal": false,
              "gridColumns": 1
            },
            "approval": {
              "dialog": {
                "title": "办理流程",
                "fullscreen": true,
                "fullscreenable": false,
                "appendToBody": true,
                "destroyOnClose": true,
                "closeOnClickModal": false,
                "gridColumns": 1
              },
              "directionColumn": {
                "type": "r-text",
                "props": {"field": "directionLabel", "label": "方向", "readonly": true, "minWidth": 72}
              },
              "verification": {
                "type": "r-toolbar",
                "id": "mobileApprovalVerification",
                "children": [
                  {
                    "type": "r-button",
                    "id": "mobileApprovalVerify",
                    "props": {
                      "commandId": "verify",
                      "label": "核验原办理结果",
                      "onClick": "runVerify"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      {
        "id": "workflowAppend",
        "type": "RenderWorkflowAppend",
        "props": {
          "dialog": {
            "id": "appendDialog",
            "type": "r-dialog",
            "props": {
              "title": "追加办理人",
              "width": "92vw",
              "appendToBody": true,
              "destroyOnClose": true
            }
          },
          "rules": [
            {
              "id": "appendParticipants",
              "type": "r-table",
              "props": {
                "autoColumns": false,
                "showPagination": false,
                "showDataViewMeta": false,
                "maxHeight": 380,
                "actions": {
                  "children": [
                    {
                      "type": "r-button",
                      "props": {
                        "label": "撤回",
                        "link": true,
                        "buttonType": "primary",
                        "onClick": "runRevokeAppend"
                      }
                    }
                  ]
                }
              },
              "children": [
                {
                  "type": "r-text",
                  "props": {
                    "field": "ReceiveUserName",
                    "label": "办理人",
                    "readonly": true,
                    "minWidth": 180
                  }
                },
                {
                  "type": "r-select",
                  "props": {
                    "field": "StepState",
                    "label": "步骤状态",
                    "readonly": true,
                    "minWidth": 120,
                    "optionValueField": "value",
                    "optionLabelField": "label"
                  }
                },
                {
                  "type": "r-select",
                  "props": {
                    "field": "STATUS",
                    "label": "办理状态",
                    "readonly": true,
                    "minWidth": 120,
                    "optionValueField": "value",
                    "optionLabelField": "label"
                  }
                }
              ]
            },
            {
              "id": "appendInput",
              "type": "r-form",
              "props": {
                "autoColumns": false,
                "showDataViewMeta": false
              },
              "children": [
                {
                  "type": "r-user-picker",
                  "props": {
                    "field": "receiveUsers",
                    "label": "办理人",
                    "multiple": true,
                    "valueMode": "array",
                    "optionLabelField": "name",
                    "optionValueField": "value"
                  }
                }
              ]
            },
            {
              "id": "appendLimits",
              "type": "r-form",
              "props": {
                "autoColumns": false,
                "showDataViewMeta": false
              },
              "children": [
                {
                  "type": "r-number",
                  "props": {
                    "field": "minNum",
                    "label": "最少人数",
                    "readonly": true
                  }
                },
                {
                  "type": "r-number",
                  "props": {
                    "field": "maxNum",
                    "label": "最多人数",
                    "readonly": true
                  }
                }
              ]
            },
            {
              "id": "appendActions",
              "type": "r-toolbar",
              "props": {
                "wrap": true,
                "gap": 8
              },
              "children": [
                {
                  "id": "openAppendInput",
                  "type": "r-button",
                  "props": {
                    "label": "添加办理人",
                    "buttonType": "primary",
                    "onClick": "runOpenAppendInput"
                  }
                },
                {
                  "id": "verifyAppendList",
                  "type": "r-button",
                  "props": {
                    "label": "核验原命令结果",
                    "onClick": "runVerifyAppendList"
                  }
                }
              ]
            },
            {
              "id": "appendInputActions",
              "type": "r-toolbar",
              "props": {
                "wrap": true,
                "gap": 8,
                "justify": "end"
              },
              "children": [
                {
                  "id": "verifyAppendInput",
                  "type": "r-button",
                  "props": {
                    "label": "核验原命令结果",
                    "onClick": "runVerifyAppendInput"
                  }
                },
                {
                  "id": "cancelAppendInput",
                  "type": "r-button",
                  "props": {
                    "label": "取消",
                    "onClick": "runCancelAppendInput"
                  }
                },
                {
                  "id": "confirmAppendInput",
                  "type": "r-button",
                  "props": {
                    "label": "确认",
                    "buttonType": "primary",
                    "onClick": "runConfirmAppendInput"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": "workflowChart",
        "type": "RenderWorkflowChart",
        "props": {
          "dialog": {
            "id": "chartDialog",
            "type": "r-dialog",
            "props": {
              "title": "流程图",
              "width": "94vw",
              "top": "3vh",
              "appendToBody": true,
              "destroyOnClose": true
            },
            "children": [
              {
                "id": "chartContent",
                "type": "r-section",
                "props": {
                  "bordered": false,
                  "gridColumns": 1,
                  "onBeforeRender": "bindChartStatus"
                },
                "children": [
                  {
                    "id": "flowChart",
                    "type": "r-graph",
                    "props": {
                      "class": "flow-run-page__chart",
                      "labelField": "TITLE",
                      "edgeSourceField": "UpNodeID",
                      "edgeTargetField": "NextNodeID",
                      "backgroundPattern": "dots",
                      "disabled": true,
                      "nodeBadgeRules": [
                        {
                          "field": "runGraphBadge",
                          "value": "waiting",
                          "label": "待办",
                          "tone": "warning"
                        },
                        {
                          "field": "runGraphBadge",
                          "value": "completed",
                          "label": "已完成",
                          "tone": "success"
                        }
                      ],
                      "onBeforeRender": "bindChartGraph",
                      "style": {
                        "minHeight": "50vh"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "type": "RenderWorkflowActions",
        "id": "mobileWorkflowFooter",
        "props": {
          "mobile": true,
          "bar": {
            "type": "r-toolbar",
            "id": "mobilePageActions",
            "props": {
              "class": "flow-run-page__mobile-footer",
              "wrap": true,
              "gap": 8
            },
            "children": [
              {
                "type": "r-button",
                "id": "mobileReturn",
                "props": {
                  "commandId": "mobileReturn",
                  "label": "返回",
                  "onClick": "goBackToWorkflowCaller"
                }
              },
              {
                "type": "r-button",
                "id": "mobile-chart",
                "props": {
                  "label": "流程图",
                  "onClick": "runChart",
                  "commandId": "chart"
                }
              },
              {
                "type": "r-button",
                "id": "mobileHistory",
                "props": {
                  "commandId": "mobileHistory",
                  "label": "历史",
                  "onClick": "showWorkflowHistory"
                }
              },
              {
                "type": "r-button",
                "id": "mobile-handle",
                "props": {
                  "label": "办理",
                  "buttonType": "primary",
                  "onClick": "runHandle",
                  "commandId": "handle"
                }
              },
              {
                "type": "r-button",
                "id": "mobile-append",
                "props": {
                  "label": "加签",
                  "onClick": "runAppend",
                  "commandId": "append"
                }
              },
              {
                "type": "r-button",
                "id": "mobile-revoke",
                "props": {
                  "label": "撤回",
                  "onClick": "runRevoke",
                  "commandId": "revoke"
                }
              },
              {
                "type": "r-button",
                "id": "mobile-verify",
                "props": {
                  "label": "核验原办理结果",
                  "onClick": "runVerify",
                  "commandId": "verify"
                }
              }
            ]
          }
        }
      }
    ]
  }
]
